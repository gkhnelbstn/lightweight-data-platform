# Copy to `.env` and fill in what you need. `.env` is gitignored, so it is the
# one file that does not travel with the repository -- docs/setup.md says what
# each of these is for and which of them you can leave out.
#
#   cp .env.example .env
#
# Everything here has a working default in compose.yaml except the two Slack
# lines, which are off on purpose: `DATACOLLABORATION_ENABLED: true` with an
# empty token makes ODD refuse to start.

# --- the raw-SQL rule authoring token ---------------------------------------
# The one route in the API that compiles a statement somebody typed and runs it
# against the source. Generated and printed once at startup when unset; set it
# to something you chose if the panel is reachable by anyone else.
DQ_API_TOKEN=

# --- discussions about an asset (ODD) ---------------------------------------
# deploy/slack-app-manifest.yaml is the app to create; the bot token is the
# workspace owner's to mint. Both must be set together.
# ODD_SLACK_ENABLED=true
# ODD_SLACK_TOKEN=xoxb-your-workspace-token

# --- where a newly failing check is announced --------------------------------
# One webhook, one POST per run, and only what is *newly* failing
# (core/alerts.py). Empty means no alerting.
DQ_ALERT_URL=

# --- the links the platform writes into ODD ----------------------------------
# What a person's browser can reach, which is not what the containers use.
DQ_ODD_UI_URL=http://localhost:8080

# --- the panel's origin ------------------------------------------------------
# ODD's own UI calls the API cross-origin; these are the origins allowed to.
DQ_CORS_ORIGINS=http://localhost:8080
