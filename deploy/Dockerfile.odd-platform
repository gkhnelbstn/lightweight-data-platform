# ODD Platform with the contract panel on its own Data Quality page.
#
# ODD reports quality and cannot edit it: there is no "create test" anywhere in
# its UI, because a test arrives through ingestion. The contract behind those
# tests *is* editable, and the place that belongs is next to the dashboard
# saying a check failed -- not on a second port a person has to be told about.
# ODD has no plugin system, no embed and no custom tab, so this is a fork.
#
# It is deliberately the smallest fork that can work:
#
#   * only the UI is rebuilt. The SPA ships as `/app/libs/odd-platform-ui-*.jar`
#     -- a plain Vite `dist/` under `static/` -- and the platform's own
#     classpath file names it, so replacing that one file changes the UI and
#     nothing else. No Gradle, and until 0.29.0 no Java at all.
#   * two lines against upstream, applied by a script that fails loudly when
#     the anchor moves (deploy/odd-platform-dq-panel.mjs). Everything else is
#     ours, in deploy/odd-platform-ui/.
#   * one carried bug fix, in the same shape: deploy/odd-platform-lineage-icon.mjs
#     gives each lineage node its own icon (odd-platform#1898). It is a fix
#     rather than a feature, so it leaves when upstream takes it.
#   * one backend class, and only because the bug is on the server: ODD's ER
#     diagram answers 500 for any table whose columns ever changed (the `api`
#     stage below). One anchored line, compiled against the image's own
#     classpath -- still no Gradle, and nothing else in the backend changes.
#
# The cost is real and worth stating: this pins an ODD version, and every
# upgrade means rebuilding and possibly re-reading their page. Retire it the
# day ODD grows an extension point.
#
#   docker compose build odd-platform
ARG ODD_VERSION=0.29.0

# --- upstream, at the version we run -----------------------------------------
FROM alpine/git:latest AS src
ARG ODD_VERSION
WORKDIR /src
RUN git clone --depth 1 --branch ${ODD_VERSION} \
      https://github.com/opendatadiscovery/odd-platform.git .

# --- the TypeScript API client, which upstream does not commit ---------------
FROM openapitools/openapi-generator-cli:v7.2.0 AS codegen
WORKDIR /src
COPY --from=src /src /src
RUN /usr/local/bin/docker-entrypoint.sh generate \
      -c odd-platform-ui/openapi-config.yaml

# --- the UI, with our panel in it --------------------------------------------
# Upstream's .nvmrc, not a rounder number: vite 7 and their toolchain
# want it, and pnpm warns on every command otherwise.
FROM node:24-alpine AS ui
WORKDIR /src
COPY --from=codegen /src /src
COPY odd-platform-ui/ /src/odd-platform-ui/src/components/DataQuality/Contracts/
COPY odd-platform-dq-panel.mjs /tmp/patch.mjs
# A second patch, and one we would rather not have: every lineage node draws
# the root's data source icon because the SVG filter id is a constant. Fixed
# in three lines and reported as odd-platform#1898 -- delete both this line
# and the script when it merges (ADR 0011).
COPY odd-platform-lineage-icon.mjs /tmp/lineage-icon.mjs
# Turkish in ODD's own language picker, issue #44. Carried until upstream
# ships a Turkish catalogue (ADR 0011); the script says what to delete.
COPY odd-platform-tr.mjs /tmp/tr.mjs
COPY odd-platform-locale-tr.json /src/odd-platform-ui/src/locales/translations/tr.json
# The integration's own tab in ODD's menu, #78 (ADR 0022).
COPY odd-platform-integration-tab.mjs /tmp/integration-tab.mjs
# An asset's Discussions tab in Google Chat instead of Slack (ADR 0028).
COPY odd-platform-discussions.mjs /tmp/discussions.mjs
RUN node /tmp/patch.mjs /src && node /tmp/lineage-icon.mjs /src && node /tmp/tr.mjs /src     && node /tmp/integration-tab.mjs /src && node /tmp/discussions.mjs /src
WORKDIR /src/odd-platform-ui
# pnpm is pinned rather than taken from corepack: the lockfile is version 9.0
# and corepack hands out whatever is current, which rejects it under
# --frozen-lockfile. A fork that cannot reproduce its own build is not a fork,
# it is a snapshot. --ignore-scripts skips upstream's husky preinstall.
RUN npm install --global --silent pnpm@9.15.9     && pnpm install --frozen-lockfile --ignore-scripts
# `pnpm build` also runs the code generator, which needs a Docker socket. The
# generation already happened in the stage above, so only the compile is run
# here -- and `tsc` is kept, because a panel that type-checks against their
# components is the point of forking rather than injecting.
RUN pnpm tsc --noEmit && pnpm build-only

# --- the jar the platform already expects on its classpath -------------------
FROM alpine:3.20 AS pack
ARG ODD_VERSION
RUN apk add --no-cache zip
WORKDIR /pack
# `build/ui`, not `dist`: vite.config.ts sets outDir, and upstream's own
# build.gradle does `from buildUI into 'static'` -- the same move this makes.
COPY --from=ui /src/odd-platform-ui/build/ui/ ./static/
RUN zip -qr /odd-platform-ui-${ODD_VERSION}.jar static \
    && mv /odd-platform-ui-${ODD_VERSION}.jar /ui.jar

# --- one backend class: the ER diagram of a table whose columns changed -------
# ODD keeps a `dataset_field` row per structure version, so a column that was
# ever re-typed or made NOT NULL has several rows under one ODDRN, and
# extractErdDetails collects them with a `toMap` that has no merge function:
# `IllegalStateException: Duplicate key`, a 500 on Data Modelling >
# Relationships. The fix keeps the newest row. The class is compiled against
# the platform image's own classes and jars, with the Lombok their build uses,
# and replaces the one in /app/classes; the build fails if the line moves.
# Reported upstream as odd-platform#1880. Delete this stage and its COPY
# when a release carries the fix -- tracked in ADR 0011 and issue #8.
FROM ghcr.io/opendatadiscovery/odd-platform:${ODD_VERSION} AS platform
FROM eclipse-temurin:17-jdk AS api
COPY --from=platform /app/classes /app/classes
COPY --from=platform /app/libs /app/libs
ADD https://repo1.maven.org/maven2/org/projectlombok/lombok/1.18.34/lombok-1.18.34.jar /lombok.jar
COPY --from=src /src/odd-platform-api/src/main/java/org/opendatadiscovery/oddplatform/repository/reactive/ReactiveRelationshipsRepositoryImpl.java /patch/
RUN set -e; f=/patch/ReactiveRelationshipsRepositoryImpl.java;     anchor='.collect(Collectors.toMap(DatasetFieldPojo::getOddrn, identity()));';     [ "$(grep -cF "$anchor" $f)" = 1 ] || { echo "ERD anchor moved in $f" >&2; exit 1; };     sed -i 's/Collectors.toMap(DatasetFieldPojo::getOddrn, identity()))/Collectors.toMap(DatasetFieldPojo::getOddrn, identity(), (a, b) -> a.getId() > b.getId() ? a : b))/' $f;     javac --release 17 -nowarn -proc:full -processorpath /lombok.jar       -cp "/app/classes:/app/libs/*:/lombok.jar" -d /out $f
# ODDRN models the Java generator lacks: SQL Server's, and our own contract
# checks'. Without them the Directory files both under "Other". The generator
# discovers models by scanning their package, so a class only has to be on the
# classpath. Delete MssqlPathsModel when oddrn-generator-java ships one.
COPY odd-platform-api/*.java /patch/models/
RUN javac --release 17 -nowarn -proc:full -processorpath /lombok.jar \
      -cp "/app/classes:/app/libs/*:/lombok.jar" -d /out /patch/models/*.java

FROM ghcr.io/opendatadiscovery/odd-platform:${ODD_VERSION}
ARG ODD_VERSION
COPY --from=pack /ui.jar /app/libs/odd-platform-ui-${ODD_VERSION}.jar
COPY --from=api /out/ /app/classes/
