# Apache SeaTunnel for integration flows (ADR 0020), as small as it can be and
# with one upstream commit carried until a release has it (ADR 0011).
#
# * Slim: the official image is 6.97 GB, 2.4 GB of it connectors this
#   repository does not use. This keeps the seven it does, and only the four
#   jars of lib/ they need. The official lib/ also ships opengauss-jdbc, which
#   shadows pgjdbc and breaks every Postgres connection
#   (apache/seatunnel#10242, #11510); it is simply not copied.
# * Patched: 2.3.13's `EventTime` is when SeaTunnel *read* a change. A
#   conflict rule of "the latest edit wins" needs when it *committed*, which is
#   `SourceTimestamp` from apache/seatunnel#10667 -- merged in April 2026,
#   after 2.3.13. It is cherry-picked here, and the build fails if it stops
#   applying. Verified against SQL Server: `SourceTimestamp` equals
#   `cdc.lsn_time_mapping.tran_end_time` to the millisecond.
#
# * Patched again, and this one is ours: the `Http` source waits out
#   `poll_interval_millis` holding the checkpoint lock, so a streaming job's
#   checkpoint never completes and SeaTunnel fails the job. `Object.wait`
#   frees the monitor while it waits; `Thread.sleep` does not. Issue #126,
#   reported as apache/seatunnel#12411 with the fix as #12412 -- so this one
#   is deleted when a release carries that, not when somebody notices.
#
# Delete the `src` and `build` stages, and the COPY lines from `build`, when a
# SeaTunnel release carries #10667 *and* the Http reader stops sleeping under
# the checkpoint lock.
#
#   docker build -f deploy/Dockerfile.seatunnel -t ldp/seatunnel deploy
ARG SEATUNNEL_VERSION=2.3.13

# --- upstream at the release, plus the one commit ----------------------------
FROM alpine/git:latest AS src
ARG SEATUNNEL_VERSION
WORKDIR /src
RUN git clone -q --filter=blob:none --no-checkout https://github.com/apache/seatunnel.git . \
    && git checkout -q ${SEATUNNEL_VERSION} \
    && git fetch -q origin 6dee790d77830f43690d9e2cf0593d27c8b1c242 \
    && git -c user.name=ldp -c user.email=ldp@localhost \
         cherry-pick 6dee790d77830f43690d9e2cf0593d27c8b1c242
# ...and one gap of upstream's own, which has no commit to take: the `Http`
# source waits out `poll_interval_millis` holding the checkpoint lock, which
# is the lock the barrier needs, so a streaming job's checkpoint never
# completes and SeaTunnel fails the job (#126). `Object.wait` releases the
# monitor while it waits and `Thread.sleep` does not, so the fix is the word.
# The monitor is held there -- `pollNext` takes it around the whole poll -- so
# this is legal, and a spurious wake-up only polls early. The anchor fails the
# build rather than letting a patch that no longer applies pass unnoticed,
# exactly as the ODD one does (ADR 0011).
RUN f=seatunnel-connectors-v2/connector-http/connector-http-base/src/main/java/org/apache/seatunnel/connectors/seatunnel/http/source/HttpSourceReader.java; \
    test "$(grep -c 'Thread.sleep(httpParameter.getPollIntervalMillis());' $f)" = "1" \
      || { echo "the Http poll sleep moved; see ADR 0020 and issue #126"; exit 1; }; \
    sed -i 's/Thread\.sleep(httpParameter\.getPollIntervalMillis());/output.getCheckpointLock().wait(httpParameter.getPollIntervalMillis());/' $f

# --- only the jars the patches change ----------------------------------------
FROM maven:3.9-eclipse-temurin-8 AS build
ARG SEATUNNEL_VERSION
COPY --from=src /src /src
WORKDIR /src
RUN --mount=type=cache,target=/root/.m2 \
    mvn -q -B -Drevision=${SEATUNNEL_VERSION} -DskipTests -Dmaven.test.skip=true \
        -Dspotless.check.skip=true -Dspotless.apply.skip=true -Dcheckstyle.skip=true \
        -Dlicense.skip=true -Drat.skip=true -Dmaven.javadoc.skip=true \
        -pl seatunnel-core/seatunnel-starter,seatunnel-connectors-v2/connector-cdc/connector-cdc-base,seatunnel-connectors-v2/connector-http/connector-http-base \
        -am install
# The Http connector's jar carries the Scala version in its name and the
# distribution's does not, so it is renamed here rather than guessed in a
# COPY. The glob matches the shaded jar only -- Maven's untouched one is
# `original-`-prefixed -- and `cp` fails loudly if that ever stops being true.
RUN cp seatunnel-connectors-v2/connector-http/connector-http-base/target/connector-http-base-*.jar        /connector-http-base-${SEATUNNEL_VERSION}.jar

FROM apache/seatunnel:${SEATUNNEL_VERSION} AS dist

# --- the runtime -------------------------------------------------------------
FROM eclipse-temurin:8-jre
ARG SEATUNNEL_VERSION
WORKDIR /opt/seatunnel
ENV SEATUNNEL_HOME=/opt/seatunnel
COPY --from=dist /opt/seatunnel/bin bin
COPY --from=dist /opt/seatunnel/config config
COPY --from=dist /opt/seatunnel/plugins plugins
COPY --from=dist /opt/seatunnel/starter/logging starter/logging
COPY --from=dist /opt/seatunnel/connectors/plugin-mapping.properties connectors/
COPY --from=dist ["/opt/seatunnel/connectors/connector-cdc-sqlserver-${SEATUNNEL_VERSION}.jar", \
                  "/opt/seatunnel/connectors/connector-cdc-postgres-${SEATUNNEL_VERSION}.jar", \
                  "/opt/seatunnel/connectors/connector-cdc-mongodb-${SEATUNNEL_VERSION}.jar", \
                  "/opt/seatunnel/connectors/connector-jdbc-${SEATUNNEL_VERSION}.jar", \
                  "/opt/seatunnel/connectors/connector-mongodb-${SEATUNNEL_VERSION}.jar", \
                  "connectors/"]
COPY --from=dist ["/opt/seatunnel/lib/seatunnel-transforms-v2.jar", \
                  "/opt/seatunnel/lib/seatunnel-hadoop3-3.1.4-uber.jar", \
                  "/opt/seatunnel/lib/mssql-jdbc-9.2.1.jre8.jar", \
                  "/opt/seatunnel/lib/postgresql-42.4.3.jar", \
                  "lib/"]
COPY --from=build /src/seatunnel-core/seatunnel-starter/target/seatunnel-starter.jar starter/
COPY --from=build /src/seatunnel-connectors-v2/connector-cdc/connector-cdc-base/target/connector-cdc-base-${SEATUNNEL_VERSION}.jar connectors/
COPY --from=build /connector-http-base-${SEATUNNEL_VERSION}.jar connectors/
